# Flask Environment
FLASK_ENV=production
SECRET_KEY=change-to-a-very-long-random-secret-key-for-production

# Neon Database (PostgreSQL Serverless)
# Get from https://console.neon.tech -> Connection Details -> Connection string (URI)
# Example: postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:password@ep-xyz.neon.tech/neondb?sslmode=require

# Cloudinary (Media & CDN File Storage)
# Get from https://cloudinary.com/console -> Dashboard -> Product Environment Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Or use the single URL format:
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Live URL for Customer QR Code (e.g. Render hosted domain)
# Customers scanning the QR will be directed here
APP_BASE_URL=https://the-royal-feast.onrender.com

# Domain Configuration (Optional subdomains, leave defaults for single domain)
CUSTOMER_DOMAIN=localhost:5000
ADMIN_DOMAIN=admin.localhost:5000
KITCHEN_DOMAIN=kitchen.localhost:5000
WAITER_DOMAIN=waiter.localhost:5000

# Local Upload Fallback
UPLOAD_FOLDER=app/static/uploads
MAX_UPLOAD_SIZE=5242880

# Business Configuration
TAX_PERCENT=10.0
SERVICE_CHARGE_PERCENT=5.0
CURRENCY_SYMBOL=₹

# Token Pool Configuration
TOKEN_START=1
TOKEN_END=40
